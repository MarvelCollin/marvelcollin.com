# ─────────────────────────────────────────────────────────────────────────────
# CLIENT — exposed in the browser bundle by Vite (VITE_ prefix is required).
# Safe to be public: project URL + the Supabase publishable/anon key. Security is
# enforced by Row Level Security, NOT by hiding these.
# Set these in Vercel → Project → Settings → Environment Variables (Prod + Preview).
# ─────────────────────────────────────────────────────────────────────────────
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_ANON_KEY=sb_publishable_XXXXXXXXXXXXXXXXXXXXXXXX

# Optional — which Supabase auth user the admin login signs in as. You only ever
# type the PASSWORD on the login screen; this is just the hidden identifier.
# Defaults to admin@portfolio.local if unset.
VITE_ADMIN_EMAIL=admin@portfolio.local

# ─────────────────────────────────────────────────────────────────────────────
# SERVER / LOCAL ONLY — used by `npm run db:*` (migrations & seeding).
# Do NOT prefix with VITE_ and do NOT add these to Vercel: the deployed site never
# needs them. Keep them only in your local, gitignored .env. Treat the password as
# a real secret (long, random value).
# ─────────────────────────────────────────────────────────────────────────────
SUPABASE_PROJECT_REF=YOUR_PROJECT_REF
SUPABASE_DB_PASSWORD=use-a-long-random-password
SUPABASE_DB_URL=postgresql://postgres.YOUR_PROJECT_REF:use-a-long-random-password@aws-1-ap-southeast-1.pooler.supabase.com:5432/postgres
