{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/fonts/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(img|shots|certs|logos|me)/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=604800, stale-while-revalidate=2592000"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/pantau",
      "destination": "https://pantau-plum.vercel.app/pantau/"
    },
    {
      "source": "/pantau/",
      "destination": "https://pantau-plum.vercel.app/pantau/"
    },
    {
      "source": "/pantau/:path*",
      "destination": "https://pantau-plum.vercel.app/pantau/:path*"
    },
    {
      "source": "/quizlingo",
      "destination": "https://quizlingo-coral.vercel.app/quizlingo/"
    },
    {
      "source": "/quizlingo/",
      "destination": "https://quizlingo-coral.vercel.app/quizlingo/"
    },
    {
      "source": "/quizlingo/:path*",
      "destination": "https://quizlingo-coral.vercel.app/quizlingo/:path*"
    },
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ]
}
