{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=(), payment=(), usb=()"
        }
      ]
    },
    {
      "source": "/",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self' 'sha256-8X0iUVr1Y3PY/zn04Y9jUbxRvjQOEswOvEvJV9/Tluc='; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https:; font-src 'self'; connect-src 'self'; frame-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'"
        }
      ]
    },
    {
      "source": "/index.html",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self' 'sha256-8X0iUVr1Y3PY/zn04Y9jUbxRvjQOEswOvEvJV9/Tluc='; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https:; font-src 'self'; connect-src 'self'; frame-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/fonts/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(img|shots|certs|logos|me)/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=604800, stale-while-revalidate=2592000"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/pantau",
      "destination": "https://pantau-plum.vercel.app/pantau/"
    },
    {
      "source": "/pantau/",
      "destination": "https://pantau-plum.vercel.app/pantau/"
    },
    {
      "source": "/pantau/:path*",
      "destination": "https://pantau-plum.vercel.app/pantau/:path*"
    },
    {
      "source": "/quizlingo",
      "destination": "https://quizlingo-coral.vercel.app/quizlingo/"
    },
    {
      "source": "/quizlingo/",
      "destination": "https://quizlingo-coral.vercel.app/quizlingo/"
    },
    {
      "source": "/quizlingo/:path*",
      "destination": "https://quizlingo-coral.vercel.app/quizlingo/:path*"
    },
    {
      "source": "/sahabatsentarum",
      "destination": "https://sahabatsentarum-six.vercel.app/sahabatsentarum/"
    },
    {
      "source": "/sahabatsentarum/",
      "destination": "https://sahabatsentarum-six.vercel.app/sahabatsentarum/"
    },
    {
      "source": "/sahabatsentarum/:path*",
      "destination": "https://sahabatsentarum-six.vercel.app/sahabatsentarum/:path*"
    },
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ]
}
